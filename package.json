{
  "name": "gitstory",
  "version": "1.0.0",
  "private": true,
  "description": "Turn any GitHub repository into an interactive historical narrative with animated timelines, contributor race charts, and AI-powered storytelling.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "framer-motion": "^14.14.0",
    "html-to-image": "^1.11.11",
    "lucide-react": "^1.80.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.11.1",
    "tailwind-merge": "^3.7.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.2",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.4.6",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
